{
  "name": "trainerdeck",
  "version": "0.6.9",
  "description": "A Decky plugin for finding, installing, binding, and directly synchronizing supported standalone FLiNG trainers.",
  "private": true,
  "homepage": "https://github.com/chen-coco/trainerdeck#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chen-coco/trainerdeck.git"
  },
  "bugs": {
    "url": "https://github.com/chen-coco/trainerdeck/issues"
  },
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "python -m unittest discover -s tests -v && node tests/test_steam.cjs && node tests/test_async.cjs && node tests/test_fling.cjs && node tests/test_input_recovery.cjs && node tests/test_automatic_add.cjs && node tests/test_index_source.cjs && node tests/test_runtime_panel_source.cjs",
    "test:python": "python -m unittest discover -s tests -v",
    "test:steam": "node tests/test_steam.cjs",
    "check": "tsc --noEmit",
    "package": "python scripts/package.py"
  },
  "keywords": [
    "decky",
    "steam-deck",
    "steamos",
    "trainer"
  ],
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "4.12.0",
    "@rollup/rollup-linux-x64-musl": "^4.54.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.54.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.5.0",
    "tslib": "^2.8.1"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
