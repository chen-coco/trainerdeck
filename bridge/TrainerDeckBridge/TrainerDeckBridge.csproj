<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>TrainerDeckBridge</AssemblyName>
    <RootNamespace>TrainerDeckBridge</RootNamespace>
    <OutputType>Library</OutputType>
    <Platforms>AnyCPU</Platforms>
    <TargetFrameworks>net35;net40</TargetFrameworks>
    <Version>0.7.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\BridgeManifest.cs" Link="Protocol\BridgeManifest.cs" />
    <Compile Include="..\Shared\FrameworkCompat.cs" Link="Compatibility\FrameworkCompat.cs" />
    <Compile Include="..\Shared\JsonCodec.cs" Link="Protocol\JsonCodec.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net35'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35"
                      Version="1.0.3"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net40'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net40"
                      Version="1.0.3"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
